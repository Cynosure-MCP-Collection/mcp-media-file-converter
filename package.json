{
  "name": "@cynosure-mcp/media-file-converter",
  "mcpName": "io.github.andreasjhagen/media-file-converter",
  "version": "1.1.0",
  "description": "MCP server that converts images, audio and video files between formats using ffmpeg",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "media-file-converter": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "release:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ffmpeg",
    "media-converter",
    "video",
    "audio",
    "image",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-media-file-converter.git"
  },
  "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-media-file-converter#readme",
  "bugs": {
    "url": "https://github.com/Cynosure-MCP-Collection/mcp-media-file-converter/issues"
  }
}
